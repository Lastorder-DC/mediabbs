# mediabbs backend configuration
# Copy to `.env` (or set as real environment variables) and adjust.
# Empty values are treated as unset.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Address to listen on. (legacy name: HOST)
BIND_ADDRESS=127.0.0.1:8080
DATABASE_URL=mysql://mediabbs:password@localhost/mediabbs

# Origins of mediabbs-client allowed to call the API with cookies, comma separated.
# Unset = any origin (NOT recommended in production). (legacy name: CORS, '|' separated)
CORS_ALLOWED_ORIGINS=https://bbs.example.org

# Which proxies may set Forwarded / X-Forwarded-For (used for the client IP).
#   unset        : loopback only (127.0.0.0/8, ::1) - fine for nginx on the same host
#   false        : ignore forwarding headers
#   true         : trust every hop (only if the backend is unreachable except via proxy)
#   CIDR list    : e.g. 10.0.0.0/8,192.168.0.0/16
#TRUST_PROXY=

# Optional error reporting. (legacy name: SENTRY_URL)
#SENTRY_DSN=

# Log filter (env_logger syntax). Default: actix_web=info,librebbs=info
#RUST_LOG=

# ---------------------------------------------------------------------------
# MediaWiki
# ---------------------------------------------------------------------------
# Public base URL of the wiki (scheme + host, no trailing slash).
MW_BASE_URL=https://wiki.example.org
# $wgScriptPath of the wiki: "/w" for most installs, empty if api.php is at the root.
MW_SCRIPT_PATH=/w

# Optional: URLs the *backend* uses to reach the wiki, e.g. an internal address.
# Browsers always use MW_BASE_URL + MW_SCRIPT_PATH.
#MW_API_URL=http://mediawiki/w/api.php
#MW_REST_URL=http://mediawiki/w/rest.php

# Optional: article URL template. Default: discovered from the wiki (siteinfo).
#MW_ARTICLE_PATH=/wiki/$1

# Check anonymous posters' IPs against the wiki's block list. Default: true
#CHECK_IP_BLOCKS=true

# User-Agent sent to the wiki. Default: mediabbs/<version> (+repository URL)
#MW_USER_AGENT=

# ---------------------------------------------------------------------------
# OAuth 2.0 (Extension:OAuth) - see Special:OAuthConsumerRegistration on the wiki
# ---------------------------------------------------------------------------
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# The wiki's $wgOAuth2PublicKey, in PEM format. Default: pubkey.pem
#OAUTH_PUBLIC_KEY_PATH=pubkey.pem

# ---------------------------------------------------------------------------
# Moderators
# ---------------------------------------------------------------------------
# Wiki user groups / rights allowed to hide, close, suspend and pin.
# Default groups: sysop. (librewiki used: boardmanager)
#ADMIN_GROUPS=sysop
#ADMIN_RIGHTS=

# ---------------------------------------------------------------------------
# Cookies (access/refresh tokens, HttpOnly)
# ---------------------------------------------------------------------------
# Set when the client and API are on different subdomains, e.g. example.org
#COOKIE_DOMAIN=
# Default: true. Set false only for plain-HTTP setups other than localhost.
#COOKIE_SECURE=true
# Lax (default), Strict, or None (client and API on different sites; requires Secure)
#COOKIE_SAMESITE=Lax
#COOKIE_MAX_AGE_DAYS=28

# ---------------------------------------------------------------------------
# Client / UI (served to mediabbs-client via GET /config)
# ---------------------------------------------------------------------------
# Default: the wiki's sitename.
#SITE_NAME=
#SITE_LOCALE=ko-KR
# Board shown at "/". Default: first active board.
#DEFAULT_BOARD=
# Extra navigation links, JSON array.
#NAV_LINKS=[{"label":"Maps","url":"https://maps.example.org","icon":"map"}]
#RECENT_CHANGES_ENABLED=true
# Namespaces for the recent changes / discussions panels.
# Default: content namespaces + 4,10,12,14 / all talk namespaces (from siteinfo).
#RECENT_CHANGES_NAMESPACES=0|4|10|12|14
#RECENT_DISCUSSIONS_NAMESPACES=1|3|5
#SITENOTICE_ENABLED=true
#SITENOTICE_PAGE=MediaWiki:Sitenotice
# Cache-Control max-age of GET /boards, seconds. Default: 300
#BOARDS_CACHE_SECONDS=300

# ---------------------------------------------------------------------------
# File uploads (S3)
# ---------------------------------------------------------------------------
S3_REGION=ap-northeast-2
S3_BUCKET=
# AWS credentials are read by rusoto from the usual sources
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, instance role).
