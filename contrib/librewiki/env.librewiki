# Settings reproducing the original librebbs behaviour on librewiki.net.
# See ../../.env.example for the meaning of every variable.

BIND_ADDRESS=127.0.0.1:8080
DATABASE_URL=mysql://librebbs:CHANGEME@localhost/librebbs
CORS_ALLOWED_ORIGINS=https://bbs.librewiki.net

MW_BASE_URL=https://librewiki.net
MW_SCRIPT_PATH=

OAUTH_CLIENT_ID=CHANGEME
OAUTH_CLIENT_SECRET=CHANGEME
OAUTH_PUBLIC_KEY_PATH=pubkey.pem

# librebbs used a dedicated wiki group for moderators
ADMIN_GROUPS=boardmanager

DEFAULT_BOARD=wiki
NAV_LINKS=[{"label":"맵스","url":"https://maps.librewiki.net","icon":"map"}]

# librebbs allowed anonymous image uploads
UPLOAD_REQUIRE_LOGIN=false
STORAGE_BACKEND=s3
S3_REGION=ap-northeast-2
S3_BUCKET=CHANGEME
S3_KEY_PREFIX=bbs/
UPLOAD_PUBLIC_URL=https://image.librewiki.net/
